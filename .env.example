# ==============================================================================
# SecureFlow Enterprise DevSecOps Platform - Production Environment Variables
# ==============================================================================

# 1. Server & Network Configuration
PORT=3001
NODE_ENV=production

# 2. Cryptographic Key Management Service (KMS) & Envelope Encryption
# Leave blank in local/single-node mode to auto-generate a 256-bit high-entropy
# key in server/data/.vault_master_key (chmod 600).
# In Kubernetes / AWS ECS, inject via Secret Manager:
SECUREFLOW_MASTER_KEK=

# Active KMS Provider: software-hsm | hashicorp-vault | aws-kms
KMS_PROVIDER=software-hsm
VAULT_ADDR=https://vault.internal.corp:8200
AWS_KMS_KEY_ARN=arn:aws:kms:ap-northeast-2:123456789012:key/secureflow-master-kek

# 3. Zero-Trust JWT & OIDC Authentication
# Used to sign RFC 7519 HS256 session tokens. Defaults to HMAC subkey of Master KEK if unset.
JWT_SIGNING_SECRET=

# 4. GitHub / GitLab Webhook HMAC-SHA256 Verification Secret
GITHUB_WEBHOOK_SECRET=
